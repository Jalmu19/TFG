package asint;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;

scan with {: return getScanner().next_token(); :};
parser code {: 
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {: 
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};


terminal IDEN,
         IF, ELSE, ELIF, FOR, WHILE, FUNC, RET,
         ENT, FLOAT,
         PRIV, PROT, PUB, CLASS,
         TRUE, FALSE,
         MAS, MENOS, MULTI, DIV,
         TIPO_ENT, TIPO_BOOL, TIPO_FLOAT,
         IGUAL, IGUALIGUAL, DISTINTO, PLUSPLUS, MENOSMENOS, MENOR, MAYOR, MENORI, MAYORI, PUNTOCOMA,COMA,
         PAP, PCIERRE, CAP, CCIERRE, LAP, LCIERRE;


non terminal  P, LInst, Inst, Cond, ElseCase, ElifCase, Asig, Decl, DeclVal , Bucle , Function, Types,
              LParameters, Parametros, Retorno, Op1, Increment, OpBool, E0, E1, E2, E3, E4;


P       ::= LInst;
LInst   ::= Inst LInst | ;
Inst    ::= Cond | Asig | Decl PUNTOCOMA | Bucle | Function | DeclVal PUNTOCOMA| Op1 PUNTOCOMA | Retorno PUNTOCOMA;
Asig    ::= IDEN IGUAL E0 PUNTOCOMA;
Decl    ::= Types IDEN;
DeclVal ::= Types IDEN IGUAL E0 ;
Cond    ::= IF PAP E0 PCIERRE LAP LInst LCIERRE ElifCase ElseCase;
Op1     ::= IDEN PLUSPLUS | IDEN MENOSMENOS;
Bucle   ::= FOR PAP DeclVal PUNTOCOMA E0 PUNTOCOMA Increment PCIERRE LAP LInst LCIERRE | WHILE PAP E0 PCIERRE LAP LInst LCIERRE ;
Increment ::= Op1 | E0;
ElseCase  ::= ELSE LAP LInst LCIERRE | ;
ElifCase  ::= ELIF PAP E0 PCIERRE LAP LInst LCIERRE ElifCase | ;
Function ::= FUNC Types IDEN PAP Parametros PCIERRE LAP LInst LCIERRE;
Types ::= TIPO_ENT | TIPO_BOOL | TIPO_FLOAT;
Retorno ::= RET E0 | RET;
Parametros ::= Decl LParameters | ;
LParameters ::= COMA Decl LParameters | ;
OpBool ::= IGUALIGUAL | DISTINTO | MENOR | MAYOR | MENORI | MAYORI;
E0  ::= E1 OpBool E1 | E1;
E1  ::= E1 MAS E2  | E1 MENOS E2 | E2;
E2  ::= E2 MULTI E3 | E2 DIV E3 | E3;
E3  ::= ENT  | TRUE  | FALSE | IDEN | PAP E0 PCIERRE | FLOAT ;



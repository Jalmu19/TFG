package asint;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;

scan with {: return getScanner().next_token(); :};
parser code {: 
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {: 
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};


terminal IDEN,
         IF, ELSE, ELIF, FOR, WHILE, FUNC, RET,
         ENT, FLOAT,
         PRIV, PROT, PUB, CLASS,
         TRUE, FALSE,
         MAS, MENOS, MULTI, DIV,
         TIPO_ENT, TIPO_BOOL, TIPO_FLOAT,
         IGUAL, IGUALIGUAL, DISTINTO, PLUSPLUS, MENOSMENOS, MENOR, MAYOR, MENORI, MAYORI, PUNTOCOMA,
         PAP, PCIERRE, CAP, CCIERRE, LAP, LCIERRE;


non terminal  P, LInst, Inst, Cond, ElseCase, ElifCase, Asig, Decl, DeclVal , Bucle , Funcion , Op1,  E0, E1, E2, E3;


P       ::= LInst;
LInst   ::= Inst LInst | ;
Inst    ::= Cond | Asig | Decl | Bucle | Funcion | DeclVal | Op1;
Asig    ::= IDEN IGUAL E0 PUNTOCOMA;
Decl    ::= TIPO_ENT IDEN PUNTOCOMA | TIPO_BOOL IDEN PUNTOCOMA;
DeclVal ::= TIPO_ENT IDEN IGUAL E0 PUNTOCOMA | TIPO_FLOAT IDEN IGUAL E0 PUNTOCOMA | TIPO_BOOL IDEN IGUAL E0 PUNTOCOMA ;
Cond        ::= IF PAP E0 PCIERRE LAP LInst LCIERRE ElifCase ElseCase;
Op1 ::= IDEN PLUSPLUS | IDEN MENOSMENOS;
Bucle ::= FOR PAP DeclVal PUNTOCOMA E0 PUNTOCOMA Op1 PCIERRE LAP LInst LCIERRE | WHILE PAP E0 PCIERRE CAP LInst CCIERRE ;
ElseCase    ::= ELSE LAP LInst LCIERRE | ;
ElifCase ::= ELIF PAP E0 PCIERRE LAP LInst LCIERRE ElifCase | ;
E0  ::= E0 MAS E1  | E1 ;
E1  ::= E1 MAYOR E2  | E2 ;
E2  ::= E2 IGUALIGUAL E3 | E3 ;
E3  ::= ENT  | TRUE  | FALSE | IDEN  | PAP E0 PCIERRE ;  


